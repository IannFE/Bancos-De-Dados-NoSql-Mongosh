// Exibir os bancos de dados
show databases

// Criar / Selecionar banco de dados
use streaming_musica

// Criar nova collection
db.createCollection("faixas")

// Mostrar todas as collections
show collections

// Mostrar todos os documentos/objetos
db.faixas.find()

// Inserir apenas 1 document (objeto com array e objeto embutido)
db.faixas.insertOne({
  "titulo": "Bohemian Rhapsody",
  "artista": "Queen",
  "duracao_segundos": 354,
  "generos": ["Rock Progressivo", "Hard Rock", "Ópera"],
  "album": {
    "nome": "A Night at the Opera",
    "ano_lancamento": 1975,
    "gravadora": "EMI Records"
  }
})

// Inserir muitos documents de uma vez
db.faixas.insertMany([
  { "titulo": "Gostava Tanto de Você", "artista": "Tim Maia" },
  { "titulo": "Creep", "artista": "Radiohead" },
  { "titulo": "Na hora do almoço", "artista": "Belchior" },
  { "titulo": "Billie Jean", "artista": "Michael Jackson" },
  { "titulo": "Apenas Um Rapaz Latino Americano", "artista": "Belchior" }
  { "titulo": "Eu Te Devoro", "artista": "Djavan" },
])

// Buscar pelo campo
db.faixas.find({ "titulo": "Gostava Tanto de Você" })

// Buscar pelo identificador único
db.faixas.find({ _id: ObjectId('664fc8b1a3d94e21a8f90c44') })


// Embarcado VS Por referencia 
one-to-one (um para um)
Embarcado
db.patients.insertOne({name: "Jefté", age: 35, diseaseSummary: {diseases: ["cold", "broken leg"]}})

Por referencia
db.persons.insertOne({name: "Jefté", age: 35, salary: 3000})
db.cars.insertOne({model: "BMW", price: 40000, owner: ObjectId('6aa9e2cee9c288ce1241317e')})

one-to-many (um para muitos)
Embarcado
db.questionThreads.insertOne({creator: "Jefté", question: "How does that work?", answers: [{text: "Like that."}, {text: "Thanks!"}]})

Referencia
db.cities.insertOne({name: "New York City", coordinates: {lat: 21, lng: 55}})
db.citizens.insertMany([{name: "Jefté Goes", cityId: ObjectId("5b98d6b44d01c52e1637a99f")}, {name: "Brenno Salvador", cityId: ObjectId("5b98d6b44d01c52e1637a99f")}])


many-to-many (muitos para muitos)
Embarcado
db.customers.insertOne({name: "Jefté", age: 35})
db.customers.updateOne({}, {$set: {orders: [{title: "A Book", price: 12.99, quantity: 2}]}})

Referencia
db.authors.insertMany([{name: "Jorge Amado", age: 78, address: {street: "Bahia"}}, {name: "Graciliano Ramos", age: 55, address: {stree: "Rio de Janeiro"}}])
db.books.updateOne({}, {$set: {authors: [ObjectId("5b98d9e44d01c52e1637a9a6"), ObjectId("5b98d9e44d01c52e1637a9a7")]}})
